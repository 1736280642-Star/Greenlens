# Repository/API mode
NEXT_PUBLIC_ANALYSIS_REPOSITORY=http
NEXT_PUBLIC_ANALYSIS_API_BASE_URL=/api/v1

# GreenLens server-side DeepSeek provider. Never prefix secrets with NEXT_PUBLIC_.
GREENLENS_AI_ENABLED=false
GREENLENS_AI_PROVIDER=deepseek
GREENLENS_AI_BASE_URL=https://api.deepseek.com
GREENLENS_AI_MODEL=deepseek-v4-flash
GREENLENS_AI_API_KEY=
GREENLENS_AI_TIMEOUT_MS=60000
GREENLENS_AI_TEMPERATURE=0.1
GREENLENS_AI_MAX_TOKENS=1600
GREENLENS_AI_MAX_EVIDENCE_CHARS=600
GREENLENS_RESUME_REINDEX_ON_START=0
