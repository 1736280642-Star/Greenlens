{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-mock/types/**/*.ts",
    ".next-mock/dev/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next-prod/dev/types/**/*.ts",
    ".next-prod2/types/**/*.ts",
    ".next-prod2/dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release/dev/types/**/*.ts",
    ".next-release2/types/**/*.ts",
    ".next-release2/dev/types/**/*.ts",
    ".next-prod3/types/**/*.ts",
    ".next-prod3/dev/types/**/*.ts",
    ".next-prod4/types/**/*.ts",
    ".next-prod4/dev/types/**/*.ts",
    ".next-prod5/types/**/*.ts",
    ".next-prod5/dev/types/**/*.ts",
    ".next-r1/types/**/*.ts",
    ".next-r1/dev/types/**/*.ts",
    ".next-r2/types/**/*.ts",
    ".next-r2/dev/types/**/*.ts",
    ".next-r3/types/**/*.ts",
    ".next-r3/dev/types/**/*.ts",
    ".next-production-20260820/types/**/*.ts",
    ".next-production-20260820/dev/types/**/*.ts",
    ".next-production-light/types/**/*.ts",
    ".next-production-light/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-playwright/types/**/*.ts",
    ".next-playwright/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
